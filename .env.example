# Copier vers .env.local. Ne jamais committer .env.local.

# Base Postgres (dev local : `npm run db:start` lance un Postgres sur le port 5433)
DATABASE_URL=postgresql://layr:layr@localhost:5433/layr

# IA (étape 4) : clé Gemini, côté serveur uniquement
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Admin : e-mails (séparés par des virgules) qui ont accès à /admin
# ADMIN_EMAILS=

# Dossier des captures créées par l'admin (volume à monter en production)
# MEDIA_DIR=./data/media
